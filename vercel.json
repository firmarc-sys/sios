{
  "$schema":"https://openapi.vercel.sh/vercel.json",
  "version":2,
  "name":"jahorin-mercury",
  "buildCommand":"npm run build",
  "outputDirectory":".",
  "rewrites":[
    {"source":"/api/:path*","destination":"https://ari-689058655022.us-west1.run.app/api/:path*"},
    {"source":"/assets2/:path*","destination":"https://raw.githubusercontent.com/firmarc-sys/Mercury-TimeRunner/main/static/assets2/:path*"}
  ],
  "headers":[
    {"source":"/api/:path*","headers":[{"key":"x-vercel-enable-rewrite-caching","value":"0"},{"key":"Cache-Control","value":"no-store"}]},
    {"source":"/sw.js","headers":[{"key":"Cache-Control","value":"no-cache"}]},
    {"source":"/(.*)","headers":[{"key":"X-Content-Type-Options","value":"nosniff"},{"key":"Referrer-Policy","value":"strict-origin-when-cross-origin"}]}
  ]
}